# Copy this file to e2e/test.env and edit the values before running the live
# review test. Never put a token in this file; the harness resolves credentials
# from the matching local `gh` accounts.

OPENMERGELENS_E2E_REPO='OWNER/DEDICATED-E2E-REPO'
OPENMERGELENS_E2E_USERNAME='reviewer-account'
OPENMERGELENS_E2E_AUTHOR_USERNAME='author-account'

# Select one generated reviewer backend. A custom MCP-compatible reviewer may
# be used instead, but must contain both placeholders.
OPENMERGELENS_E2E_REVIEWER_BACKEND='claude'
# OPENMERGELENS_E2E_REVIEWER_COMMAND='custom-reviewer --config {{mcp_config}} --tool {{mcp_tool}}'

OPENMERGELENS_E2E_HOST='github.com'

# The defaults create a disposable PR, post a real review with inline comments,
# then close the PR and delete its branch.
# OPENMERGELENS_E2E_MODE='post'
# OPENMERGELENS_E2E_PROVISION='1'
# OPENMERGELENS_E2E_BASE_BRANCH='main'

OPENMERGELENS_E2E_REVIEW_FOCUS_COUNT='1'
OPENMERGELENS_E2E_REVIEW_TIMEOUT_MS='1800000'
OPENMERGELENS_E2E_KEEP_PR='0'
OPENMERGELENS_E2E_KEEP_HOME='0'

# To use an existing PR without provisioning, set:
# OPENMERGELENS_E2E_PROVISION='0'
# OPENMERGELENS_E2E_PR='123'
# OPENMERGELENS_E2E_MODE='dry-run'
